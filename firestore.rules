rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- ORTAK YARDIMCI FONKSİYONLAR ---

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isBlockedBetween(u1, u2) {
      return exists(/databases/$(database)/documents/blocks/$(u1 + '_' + u2)) ||
             exists(/databases/$(database)/documents/blocks/$(u2 + '_' + u1));
    }

    function areAcceptedFriends(pairId) {
      return exists(/databases/$(database)/documents/friendships/$(pairId)) &&
             get(/databases/$(database)/documents/friendships/$(pairId)).data.status == 'accepted';
    }

    function hasNoPrivateContactInfo(data) {
      return !data.keys().hasAny(['email', 'phone', 'phoneNumber', 'eMail']);
    }

    // --- 1. HERKESE AÇIK PROFİLLER (E-posta/Telefon Yok, Listelenemez!) ---
    match /users/{uid} {
      allow get: if isSignedIn();
      allow list: if false;

      allow create: if isOwner(uid) &&
        hasNoPrivateContactInfo(request.resource.data) &&
        request.resource.data.uid == uid &&
        request.resource.data.username is string &&
        request.resource.data.username.matches('^[a-z0-9_]{3,20}$') &&
        request.resource.data.displayName is string &&
        request.resource.data.displayName.size() >= 1 &&
        request.resource.data.displayName.size() <= 50 &&
        getAfter(/databases/$(database)/documents/usernames/$(request.resource.data.username)).data.uid == uid;

      allow update: if isOwner(uid) &&
        hasNoPrivateContactInfo(request.resource.data) &&
        request.resource.data.uid == uid &&
        request.resource.data.username is string &&
        request.resource.data.username.matches('^[a-z0-9_]{3,20}$') &&
        request.resource.data.displayName is string &&
        request.resource.data.displayName.size() >= 1 &&
        request.resource.data.displayName.size() <= 50 &&
        (
          request.resource.data.username == resource.data.username ||
          getAfter(/databases/$(database)/documents/usernames/$(request.resource.data.username)).data.uid == uid
        );

      allow delete: if isOwner(uid);
    }

    // --- 2. BENZERSİZ KULLANICI ADLARI (Sunucu Kodu Olmadan Uniqueness) ---
    match /usernames/{username} {
      allow get: if isSignedIn();
      allow list: if false;

      allow create: if isSignedIn() &&
        username.matches('^[a-z0-9_]{3,20}$') &&
        !exists(/databases/$(database)/documents/usernames/$(username)) &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.username == username;

      allow update: if false;
      allow delete: if isSignedIn() && resource.data.uid == request.auth.uid;
    }

    // --- 3. ENGELLEME KAYITLARI (`blockerUid_blockedUid`) ---
    match /blocks/{blockId} {
      allow get: if isSignedIn() && (
        blockId.matches('^' + request.auth.uid + '_.*') ||
        (resource != null && resource.data.blockerUid == request.auth.uid)
      );
      allow list: if isSignedIn() && resource.data.blockerUid == request.auth.uid;

      allow create: if isSignedIn() &&
        request.resource.data.blockerUid == request.auth.uid &&
        request.resource.data.blockedUid is string &&
        request.resource.data.blockedUid != request.auth.uid &&
        blockId == (request.auth.uid + '_' + request.resource.data.blockedUid);

      allow update: if false;
      allow delete: if isSignedIn() && resource.data.blockerUid == request.auth.uid;
    }

    // --- 4. ARKADAŞLIK İSTEKLERİ VE DURUMLARI (`minUid_maxUid`) ---
    match /friendships/{pairId} {
      allow get: if isSignedIn() && (
        pairId.matches('^' + request.auth.uid + '_.*') ||
        pairId.matches('.*_' + request.auth.uid + '$')
      );
      allow list: if isSignedIn() && request.auth.uid in resource.data.users;

      allow create: if isSignedIn() &&
        request.resource.data.uidA is string &&
        request.resource.data.uidB is string &&
        request.resource.data.uidA < request.resource.data.uidB &&
        pairId == (request.resource.data.uidA + '_' + request.resource.data.uidB) &&
        request.resource.data.users == [request.resource.data.uidA, request.resource.data.uidB] &&
        request.auth.uid in request.resource.data.users &&
        request.resource.data.status == 'pending' &&
        request.resource.data.requesterId == request.auth.uid &&
        request.resource.data.receiverId in request.resource.data.users &&
        request.resource.data.receiverId != request.auth.uid &&
        !isBlockedBetween(request.resource.data.uidA, request.resource.data.uidB);

      allow update: if isSignedIn() &&
        request.auth.uid in resource.data.users &&
        resource.data.status == 'pending' &&
        request.resource.data.status == 'accepted' &&
        request.auth.uid == resource.data.receiverId &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt']) &&
        !isBlockedBetween(resource.data.uidA, resource.data.uidB);

      allow delete: if isSignedIn() && request.auth.uid in resource.data.users;
    }

    // --- 5. DOĞRUDAN 1:1 SOHBET (Yalnızca Metin, Kabul Edilmiş Arkadaşlar & Engelsiz) ---
    match /direct_chats/{chatId} {
      allow get: if isSignedIn() && (
        chatId.matches('^' + request.auth.uid + '_.*') ||
        chatId.matches('.*_' + request.auth.uid + '$')
      );
      allow list: if isSignedIn() && request.auth.uid in resource.data.participants;

      allow create: if isSignedIn() &&
        request.resource.data.participants.size() == 2 &&
        request.resource.data.participants[0] < request.resource.data.participants[1] &&
        chatId == (request.resource.data.participants[0] + '_' + request.resource.data.participants[1]) &&
        request.auth.uid in request.resource.data.participants &&
        areAcceptedFriends(chatId) &&
        !isBlockedBetween(request.resource.data.participants[0], request.resource.data.participants[1]);

      allow update: if isSignedIn() &&
        request.auth.uid in resource.data.participants &&
        request.resource.data.participants == resource.data.participants &&
        !isBlockedBetween(resource.data.participants[0], resource.data.participants[1]);

      allow delete: if false;

      match /messages/{messageId} {
        function chatDoc() {
          return get(/databases/$(database)/documents/direct_chats/$(chatId)).data;
        }

        allow read: if isSignedIn() && request.auth.uid in chatDoc().participants;

        allow create: if isSignedIn() &&
          request.auth.uid in chatDoc().participants &&
          !isBlockedBetween(chatDoc().participants[0], chatDoc().participants[1]) &&
          request.resource.data.senderId == request.auth.uid &&
          request.resource.data.text is string &&
          request.resource.data.text.size() >= 1 &&
          request.resource.data.text.size() <= 2000 &&
          request.resource.data.createdAt == request.time;

        allow update: if false;

        allow delete: if isSignedIn() &&
          request.auth.uid in chatDoc().participants &&
          resource.data.senderId == request.auth.uid;
      }
    }

    // --- 6. GRUPLAR (Yalnızca Metin, Maks. 50 Üye, Owner / Admin / Member Rolleri) ---
    match /groups/{groupId} {
      function isGroupMember() {
        return isSignedIn() && request.auth.uid in resource.data.memberIds;
      }
      function myRole() {
        return resource.data.roles[request.auth.uid];
      }
      function isGroupOwner() {
        return isGroupMember() && myRole() == 'owner';
      }
      function isGroupAdmin() {
        return isGroupMember() && (myRole() == 'owner' || myRole() == 'admin');
      }

      allow read: if isGroupMember();

      allow create: if isSignedIn() &&
        request.resource.data.ownerId == request.auth.uid &&
        request.auth.uid in request.resource.data.memberIds &&
        request.resource.data.memberIds.size() >= 1 &&
        request.resource.data.memberIds.size() <= 50 &&
        request.resource.data.roles[request.auth.uid] == 'owner' &&
        request.resource.data.whoCanSend in ['everyone', 'admins_only'];

      allow update: if isGroupMember() &&
        request.resource.data.memberIds.size() <= 50 &&
        (
          // 1) Grup sahibi (Owner): rol değiştirme, bilgi/ayar düzenleme ve son mesaj güncelleme
          isGroupOwner() ||
          // 2) Yönetici (Admin): owner'a dokunmadan üye ekleme/çıkarma ve grup bilgisi/ayarları düzenleme
          // (Adminler diğer adminleri atayamaz veya çıkaramaz; bu hak yalnızca owner'ındır)
          (
            isGroupAdmin() &&
            !isGroupOwner() &&
            request.resource.data.ownerId == resource.data.ownerId &&
            resource.data.ownerId in request.resource.data.memberIds &&
            request.resource.data.roles[resource.data.ownerId] == 'owner' &&
            request.resource.data.roles[request.auth.uid] == 'admin' &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'name', 'description', 'avatarPreset', 'whoCanSend',
              'memberIds', 'roles', 'memberProfiles',
              'lastMessageText', 'lastMessageSenderId', 'lastMessageSenderName',
              'lastMessageAt', 'lastReadAt', 'updatedAt'
            ]) &&
            request.resource.data.roles.diff(resource.data.roles).changedKeys().size() == 0 &&
            request.resource.data.roles.diff(resource.data.roles).addedKeys().size() <= 50 &&
            (
              // Eklenen yeni üyelerin rolü yalnızca 'member' olabilir
              request.resource.data.roles.diff(resource.data.roles).addedKeys().size() == 0 ||
              !('owner' in request.resource.data.roles.values()) ||
              request.resource.data.roles.keys().removeAll(resource.data.roles.keys()).size() > 0
            )
          ) ||
          // 3) Normal Üye veya Admin: Sadece sohbet önizlemesi/okundu güncelleme VEYA gruptan ayrılma
          (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'lastMessageText', 'lastMessageSenderId', 'lastMessageSenderName',
              'lastMessageAt', 'lastReadAt', 'updatedAt'
            ]) &&
            (
              // Sadece lastReadAt güncelliyorsa izin ver; mesaj önizlemesi değiştiriyorsa whoCanSend kontrol et
              !request.resource.data.diff(resource.data).affectedKeys().hasAny(['lastMessageText', 'lastMessageSenderId', 'lastMessageAt']) ||
              resource.data.whoCanSend == 'everyone' ||
              isGroupAdmin()
            )
          ) ||
          // 4) Üyenin kendi isteğiyle gruptan ayrılması (Owner ayrılamaz, önce grubu silebilir)
          (
            !isGroupOwner() &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds', 'roles', 'updatedAt']) &&
            !(request.auth.uid in request.resource.data.memberIds) &&
            resource.data.memberIds.size() == request.resource.data.memberIds.size() + 1 &&
            request.resource.data.memberIds.hasAll(resource.data.memberIds.removeAll([request.auth.uid])) &&
            !(request.auth.uid in request.resource.data.roles.keys())
          )
        );

      allow delete: if isGroupOwner();

      match /messages/{messageId} {
        function parentGroup() {
          return get(/databases/$(database)/documents/groups/$(groupId)).data;
        }

        allow read: if isSignedIn() && request.auth.uid in parentGroup().memberIds;

        allow create: if isSignedIn() &&
          request.auth.uid in parentGroup().memberIds &&
          (parentGroup().whoCanSend == 'everyone' || parentGroup().roles[request.auth.uid] in ['owner', 'admin']) &&
          request.resource.data.senderId == request.auth.uid &&
          request.resource.data.text is string &&
          request.resource.data.text.size() >= 1 &&
          request.resource.data.text.size() <= 2000 &&
          request.resource.data.createdAt == request.time;

        allow update: if false;

        allow delete: if isSignedIn() &&
          request.auth.uid in parentGroup().memberIds &&
          resource.data.senderId == request.auth.uid;
      }
    }

    // --- 7. ŞİKAYETLER (Yalnızca Oluşturulabilir, Okunamaz) ---
    match /reports/{reportId} {
      allow create: if isSignedIn() &&
        request.resource.data.reporterId == request.auth.uid &&
        request.resource.data.targetType in ['user', 'direct_message', 'group_message'] &&
        request.resource.data.reason is string &&
        request.resource.data.reason.size() >= 1 &&
        request.resource.data.reason.size() <= 500;

      allow read, update, delete: if false;
    }
  }
}
